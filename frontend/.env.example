# mock (default): the Vite app talks to the local json-server API on port 3001.
# live: the Vite app talks to the FastAPI backend on port 8000.
VITE_API_MODE=mock

# Only used when VITE_API_MODE=live.
VITE_API_BASE_URL=http://localhost:8000

# Only used when VITE_API_MODE=mock.
VITE_MOCK_API_URL=http://localhost:3001
