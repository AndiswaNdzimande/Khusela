# Copy to .env and fill in real values. Never commit .env to git.
# The API will not start without JWT_SECRET_KEY set.

# TASK-23: JWT – generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60

# TASK-22: Database
DATABASE_URL=sqlite:///./khusela.db

# TASK-26: Deletion scheduler (only active when START_SCHEDULER=1)
# /check does NOT store raw files by default, so the scheduler is off by default.
START_SCHEDULER=0
RAW_IMAGE_RETENTION_HOURS=24
DELETION_JOB_INTERVAL_MINUTES=15
RAW_UPLOAD_DIR=./uploads/raw

# TASK-27: PDF sandbox (low priority per contract)
PDF_SANDBOX_IMAGE=khusela-pdf-sandbox
PDF_SANDBOX_TIMEOUT_SECONDS=10

# TASK-25: Fingerprinting — Nyakallo tuned threshold is 28
PHASH_HAMMING_THRESHOLD=28

# CORS – comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Existing pipeline deps
# GEMINI_API_KEY=your_key_here
