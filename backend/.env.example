# Copy to .env and fill in real values. Never commit .env to git.
# The API will NOT start if JWT_SECRET_KEY is missing OR still set to this placeholder.

# TASK-23: JWT — generate a real secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60

# TASK-22: Database
DATABASE_URL=sqlite:///./khusela.db

# TASK-26: Deletion scheduler (off by default — /check does not store raw files)
START_SCHEDULER=0
RAW_IMAGE_RETENTION_HOURS=24
DELETION_JOB_INTERVAL_MINUTES=15
RAW_UPLOAD_DIR=./uploads/raw

# TASK-25: Fingerprinting — 1024-bit ocr.phash; threshold unused (ocr.is_near_duplicate owns it)
PHASH_HAMMING_THRESHOLD=28

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Gemini (optional — falls back to template explanation if not set)
# GEMINI_API_KEY=your_key_here

# PDF sandbox (TASK-27 — low priority, unreachable through the upload gate)
PDF_SANDBOX_IMAGE=khusela-pdf-sandbox
PDF_SANDBOX_TIMEOUT_SECONDS=10
