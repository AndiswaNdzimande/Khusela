# Generate a random secret of at least 32 bytes; never commit real secrets.
# python -c "import secrets; print(secrets.token_hex(32))"
VERIPOP_AUTH_SECRET=replace-with-a-long-random-secret-of-32-bytes-minimum
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_TTL_MINUTES=60
JWT_EXPIRE_MINUTES=60

# SQLite by default (Khusela schema). Override with Postgres later if needed.
DATABASE_URL=sqlite:///./khusela.db

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_PDF_PAGES=30
VERIPOP_DATA_DIR=./data
RAW_UPLOAD_DIR=./data

# CORS for the Khusela React frontend
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional seed password used by scripts/seed_sellers.py
KHUSELA_SEED_PASSWORD=khusela-dev-password

# ── OCR pipeline ────────────────────────────────────────────────────────────
# OCR backend: "auto" (default) | "local" | "docker"
# "auto" tries local Tesseract first, then Docker.
# Set to "local" after installing Tesseract:
#   Windows:  winget install UB-Mannheim.TesseractOCR  (restart terminal after)
#   macOS:    brew install tesseract
#   Linux:    sudo apt-get install tesseract-ocr
KHUSELA_OCR_BACKEND=auto

# If tesseract.exe is not on PATH (Windows), set the full path:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Docker image name for the OCR fallback container (built from ocr/Dockerfile)
# KHUSELA_OCR_DOCKER_IMAGE=khusela-ocr:latest

# Set to "0" to disable auto-building the Docker OCR image
# KHUSELA_OCR_AUTOBUILD=1

# ── Privacy scheduler (raw-image deletion) ──────────────────────────────────
# Set START_SCHEDULER=1 to enable the 24-hour raw-file deletion background job.
# Leave as 0 unless you configure the app to store raw images on disk.
START_SCHEDULER=0
RAW_IMAGE_RETENTION_HOURS=24
DELETION_JOB_INTERVAL_MINUTES=15
